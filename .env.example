# Yerel geliştirme için SQLite dosya yolu (dokunmanıza gerek yok)
DATABASE_URL="file:./dev.db"

# https://resend.com adresinden ücretsiz alacağınız API anahtarı
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Bildirim e-postalarının "kimden" göründüğü adres
EMAIL_FROM="SSL Tracker <onboarding@resend.dev>"

# /api/check-ssl endpoint'ini dışarıdan korumak için rastgele bir metin belirleyin
CRON_SECRET="rastgele-uzun-bir-metin"
